/*
 * Nextflow configuration for the Rutgers Amarel HPC cluster.
 *
 * Usage:
 *   nextflow run nf-core/taxprofiler -r 2.0.1 -c config/amarel.config -profile singularity ...
 *
 * Cluster facts this file encodes (verified 2026-08-31, not assumed):
 *   - Default partition is 'main': 509 nodes, 3-day wall-clock limit (sinfo -s).
 *   - Smallest node in 'main' is 32 cores / 192000 MB (sinfo -p main -o "%c %m").
 *     Limits below stay under that so a job can land on any node in the partition.
 *   - The 'singularity' module (3.1.0, built 2019) is broken and must NOT be loaded.
 *     /usr/bin/singularity on the Red Hat login nodes is Apptainer 1.5.3, which
 *     nf-core detects and uses transparently via -profile singularity.
 */

process {
    executor       = 'slurm'
    queue          = 'main'

    // Upper bounds, not requests. Each process asks for what its nf-core label
    // specifies; anything above these values is capped here.
    resourceLimits = [
        cpus:   24,
        memory: '120.GB',
        time:   '24.h',
    ]

    // Retry on transient cluster failures, not on real errors.
    //   104,134,139 = crashes    137 = OOM-killed
    //   143         = SIGTERM (preemption)     247 = out-of-memory variant
    // 'finish' lets already-running tasks complete before stopping, so -resume
    // has less to redo than it would after a hard 'terminate'.
    errorStrategy = { task.exitStatus in [104,134,137,139,143,247] ? 'retry' : 'finish' }
    maxRetries    = 2
}

executor {
    // Cap concurrent SLURM submissions so one pipeline run does not monopolise
    // the queue, and throttle the submission rate to stay friendly to the scheduler.
    queueSize      = 20
    submitRateLimit = '10/1min'
}

singularity {
    enabled    = true
    autoMounts = true

    // Without autoMounts the container cannot see /scratch and every task fails
    // with a missing-input error.
    cacheDir   = '/scratch/xw347/nfcore/singularity'
}

// Execution reports. These are written per-run and are worth keeping: they are
// the evidence of what actually ran, with what resources, and for how long.
timeline { enabled = true }
report   { enabled = true }
trace    { enabled = true }
dag      { enabled = false }
